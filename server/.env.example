# Скопируйте файл в .env и заполните значения:
#   cp .env.example .env
# .env читается docker compose и не попадает в git.

# Bearer-токен API; его же вводят в настройках сервиса в Android-приложении.
TOKEN=change-me

# Пароль пользователя PostgreSQL (fucklms).
# Не используйте символы @ : / и ? — пароль подставляется в строку DATABASE_URL.
POSTGRES_PASSWORD=change-me
